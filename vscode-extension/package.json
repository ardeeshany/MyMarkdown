{
  "name": "mymarkdown",
  "displayName": "MyMarkdown",
  "description": "Beautiful Markdown preview with colorful headings, formatted JSON, beautify, and a clickable table of contents.",
  "version": "0.2.0",
  "publisher": "mymarkdown",
  "license": "MIT",
  "homepage": "https://mymarkdown.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/ardeeshany/mymarkdown.git"
  },
  "bugs": {
    "url": "https://github.com/ardeeshany/mymarkdown/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "json",
    "beautify"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "markdown.markdownItPlugins": true,
    "commands": [
      {
        "command": "mymarkdown.beautify",
        "title": "MyMarkdown: Beautify Markdown",
        "icon": "$(sparkle)"
      },
      {
        "command": "mymarkdown.suggestLabels",
        "title": "Suggest Label Lenses",
        "category": "MyMarkdown",
        "icon": "$(tag)"
      },
      {
        "command": "mymarkdown.labelDocument",
        "title": "Label Document…",
        "category": "MyMarkdown"
      },
      {
        "command": "mymarkdown.switchLens",
        "title": "Switch Label Lens",
        "category": "MyMarkdown"
      },
      {
        "command": "mymarkdown.removeLens",
        "title": "Remove Label Lens",
        "category": "MyMarkdown"
      },
      {
        "command": "mymarkdown.toggleLabels",
        "title": "Toggle Labels",
        "category": "MyMarkdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mymarkdown.beautify",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mymarkdown.beautify",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mymarkdown.suggestLabels",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mymarkdown.labelDocument",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mymarkdown.switchLens",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mymarkdown.removeLens",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mymarkdown.toggleLabels",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mymarkdown",
          "title": "MyMarkdown",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mymarkdown": [
        {
          "id": "mymarkdown.toc",
          "name": "Contents",
          "icon": "media/icon.svg",
          "contextualTitle": "MyMarkdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mymarkdown.beautify",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "MyMarkdown",
      "properties": {
        "mymarkdown.lint": {
          "type": "boolean",
          "default": true,
          "description": "Report structure problems (heading level jumps, unclosed fences, invalid JSON blocks, mixed bullets) in the Problems panel."
        },
        "mymarkdown.registerFormatter": {
          "type": "boolean",
          "default": false,
          "description": "Register Beautify as the Markdown formatter, so Format Document and editor.formatOnSave run it. Off by default: a second Markdown formatter stops VS Code choosing one on its own, which would break format on save for anyone already using Prettier or markdownlint."
        },
        "mymarkdown.labels.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Draw label bars in the Markdown preview for documents that have them."
        },
        "mymarkdown.labels.provider": {
          "type": "string",
          "enum": [
            "auto",
            "languageModel",
            "cli"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Use an installed language model if there is one, otherwise the configured command.",
            "Only use VS Code language model providers, such as GitHub Copilot.",
            "Only use the command in mymarkdown.labels.cliCommand."
          ],
          "description": "Which AI to ask when generating labels."
        },
        "mymarkdown.labels.cliCommand": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Command run to generate labels when no language model provider is used. The request is written to its standard input and JSON is read back from its standard output. For example: `claude -p`."
        },
        "mymarkdown.labels.storagePath": {
          "type": "string",
          "default": ".mymd",
          "description": "Folder holding label files, mirroring each document path. Relative to the workspace root."
        }
      }
    },
    "markdown.previewScripts": [
      "./media/mermaid-preview.bundle.js",
      "./media/labels.js"
    ]
  }
}
